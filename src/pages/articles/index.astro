---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = (await getCollection('articles'))
  .filter(entry => entry.data.draft !== true && entry.data.published !== false)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<SiteLayout title="Articles" description="Native Astro pages and authorized publications from Discourse.">
  <h1>Articles</h1>
  <p>Astro-authored content and authorized Discourse publications share native navigation.</p>
  <ul>{entries.map(entry => (
    <li><a href={'/articles/' + (entry.data.slug ?? entry.id) + '/'}>{entry.data.title}</a></li>
  ))}</ul>
</SiteLayout>

